# Line endings: AprismJDK repo normalizes to LF in the index; Windows
# checkouts may use CRLF for .bat/.ps1 only.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.jar binary
*.png binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary

# Shell scripts must stay LF even on Windows checkouts (WSL2 builds)
*.sh text eol=lf
